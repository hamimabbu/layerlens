# Node does not load this file automatically. Use node --env-file=.env server/index.mjs.
HOST=127.0.0.1
PORT=8787
# External requests are disabled until BOTH the operator and visitor enable them.
ENABLE_EXTERNAL_LOOKUPS=false
ENABLE_INTERNETDB=false
# Explicit DNS resolver IPs, comma separated. PTR stays disabled without these.
DNS_RESOLVERS=
# Optional operator-controlled first-party IPtoASN service (never a visitor-supplied URL).
ASN_SERVICE_URL=
# Exact trusted proxy peer addresses. Leave empty for the direct local server.
TRUSTED_PROXY_IPS=
# Docker telemetry profile: resolves an internal peer, not arbitrary forwarded headers.
TRUSTED_PROXY_HOST=
# Optional separate, valid-HTTPS Fingerproxy endpoint, requested only after its button.
# APP_ORIGIN=http://localhost:8787
# TRANSPORT_ORIGIN=https://transport.your-domain.example
